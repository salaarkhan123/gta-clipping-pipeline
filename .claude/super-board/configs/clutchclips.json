{
  "version": 1,
  "description": "ClutchClips build pipeline",
  "project": {
    "owner": "salaarkhan123",
    "title": "ClutchClips build board",
    "number": 2
  },
  "worker_backend": "workflow",
  "model_tier": "medium",
  "codex": {
    "model": null
  },
  "target": {
    "type": "repo",
    "url": null
  },
  "repo": {
    "path": ".",
    "remote": "https://github.com/salaarkhan123/gta-clipping-pipeline"
  },
  "base_branch": "staging",
  "timezone": "America/Edmonton",
  "columns": [
    "Backlog",
    "Ready",
    "Building",
    "QA",
    "Review",
    "Blocked",
    "Done"
  ],
  "labels": [
    "qa",
    "bug",
    "feature"
  ],
  "paths": {
    "project_md": "docs/super-board/PROJECT.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": true,
  "merge_policy": {
    "default": "human",
    "auto_max_lines": 400,
    "allow_auto_on_production": false
  },
  "migrations": {
    "globs": [
      "alembic/versions/**",
      "**/migrations/*.sql"
    ],
    "allowed_envs": [],
    "target_env": "staging",
    "commands": {},
    "checks": {},
    "human_steps": []
  },
  "no_progress_cycles": 6,
  "max_dispatches": 0,
  "truth_gate": "non-trivial",
  "truth_threshold": 70,
  "usage_pause_pct": 95,
  "usage_fallback": "none",
  "verify_commands": [
    "cd clip-api && python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt && .venv/bin/python -m pytest -q"
  ],
  "max_workers": 1,
  "rebuild_cap": 2,
  "block_rate_alert_pct": 30,
  "collect": {
    "sources": [
      "github",
      "architecture"
    ],
    "window_days": 14,
    "architecture": {
      "max_findings": 5
    }
  },
  "notifications": {
    "channel": "session",
    "chat_id": null,
    "bot_identity": "salaarkhan123"
  }
}
