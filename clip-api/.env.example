# Copy to .env and fill in. Never commit .env.

# --- Required for production ---
ENV=prod
WEB_DOMAIN=yourdomain.com                     # the website; DNS A records for @ and www must point at the server
API_DOMAIN=api.yourdomain.com                 # DNS A record must point at the server
PUBLIC_API_URL=https://api.yourdomain.com
PUBLIC_WEB_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com
SECRET_KEY=                                   # openssl rand -hex 32
POSTGRES_PASSWORD=                            # openssl rand -hex 24

# --- Email (required in prod: verification emails gate the free credits) ---
AUTO_VERIFY_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@yourdomain.com

# --- Storage: "local" keeps files on the server disk; "s3" uses Cloudflare R2 ---
STORAGE_BACKEND=local
S3_ENDPOINT_URL=                              # https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RETENTION_DAYS=7

# --- Stripe (leave blank until ready; checkout returns "billing_unavailable") ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                        # from the webhook endpoint https://api.yourdomain.com/webhooks/stripe
CURRENCY=usd
# CREDIT_PACKS=[{"id":"pack_300","name":"300 credits","credits":300,"price_cents":499}]

# PLANS=[...]                                 # JSON list overriding the placeholder plans in app/plans.py

# --- AI titles, hashtags and virality scores (optional; off when empty) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# --- Credits, limits and cost guards ---
FREE_SIGNUP_CREDITS=30
MAX_UPLOAD_BYTES=8589934592
MAX_DURATION_SEC=21600
MAX_CONCURRENT_JOBS_PER_ACCOUNT=2
DAILY_MINUTES_CAP=6000
ACCEPT_JOBS=true                              # kill switch: set false and restart api to stop new jobs

# --- Pipeline ---
VISUAL_SEARCH=true                            # Video Finder also searches what is on screen
WHISPER_INDEX_MODEL=base.en                   # faster model for the full-video search transcript
WHISPER_MODEL=small.en                        # must match the Docker build arg; "none" disables captions
SENTRY_DSN=
