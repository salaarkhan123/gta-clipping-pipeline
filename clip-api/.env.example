# Copy to .env and fill in. Never commit .env.

# --- Required for production ---
ENV=prod
WEB_DOMAIN=yourdomain.com                     # the website; DNS A records for @ and www must point at the server
API_DOMAIN=api.yourdomain.com                 # DNS A record must point at the server
PUBLIC_API_URL=https://api.yourdomain.com
PUBLIC_WEB_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com
SECRET_KEY=                                   # openssl rand -hex 32
# SECRET_KEY_PREVIOUS=                        # only while rotating SECRET_KEY (docs/ops/credential-rotation.md)
POSTGRES_PASSWORD=                            # openssl rand -hex 24

# --- Email (required in prod: verification emails gate the free credits). See DEPLOY.md, "Email (Resend)" ---
AUTO_VERIFY_EMAIL=false
EMAIL_PROVIDER=resend                         # resend | smtp | none
RESEND_API_KEY=                               # re_...: set it on the server only, never in chat or git
EMAIL_FROM=noreply@clutchclips.io             # on a domain verified in Resend
# SMTP instead (port 587 is blocked from the droplet):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Storage: "local" keeps files on the server disk; "s3" uses Cloudflare R2 ---
STORAGE_BACKEND=local
S3_ENDPOINT_URL=                              # https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto                                # R2: auto; Spaces: the region, e.g. nyc3
SIGNED_URL_TTL_SEC=3600                       # life of a signed media link, at most 604800 (7 days)
RETENTION_DAYS=7

# --- Stripe (leave blank until ready; checkout returns "billing_unavailable") ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                        # from the webhook endpoint https://api.yourdomain.com/webhooks/stripe
CURRENCY=usd
# CREDIT_PACKS=[{"id":"pack_300","name":"300 credits","credits":300,"price_cents":499}]

# Stripe Price IDs for the plans in app/plans.py (prices and credits live there, not here). See DEPLOY.md, "Plans and
# Stripe Prices". A plan whose Price ID is blank cannot be bought. PLANS is no longer read.
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_SCALE_MONTH=
STRIPE_PRICE_SCALE_YEAR=

# --- AI titles, hashtags and virality scores (optional; off when empty) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# LLM_PASS=true                               # U3: the AI reads the whole transcript (when there is one) for moments

# --- Premium AI thumbnails (#140, paid; see DEPLOY.md). Off until provider testing and a quality check are done ---
PREMIUM_THUMBNAILS=false
GEMINI_API_KEY=                               # Gemini Nano Banana 2.1, billing-enabled project only (DEPLOY.md)
# PREMIUM_THUMB_CREDITS=25
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_IMAGE_SIZE=2K
# PREMIUM_THUMB_TIMEOUT_SEC=60

# --- Credits, limits and cost guards ---
FREE_SIGNUP_CREDITS=30
MAX_UPLOAD_BYTES=8589934592
MAX_DURATION_SEC=21600
MAX_CONCURRENT_JOBS_PER_ACCOUNT=2
DAILY_MINUTES_CAP=6000
ACCEPT_JOBS=true                              # kill switch: set false and restart api to stop new jobs

# --- Pipeline ---
VISUAL_SEARCH=true                            # Video Finder also searches what is on screen
WHISPER_INDEX_MODEL=base.en                   # faster model for the full-video search transcript
WHISPER_MODEL=small.en                        # must match the Docker build arg; "none" disables captions
SENTRY_DSN=
