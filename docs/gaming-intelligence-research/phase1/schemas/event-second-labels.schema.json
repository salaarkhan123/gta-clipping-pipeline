{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clutchclips.local/schemas/gaming-phase1-event-second-labels.json",
  "title": "Per-second gaming event labels",
  "type": "object",
  "required": ["version", "vod", "labels"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "vod": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
    "game": { "type": "string" },
    "timebase": { "const": "source_seconds" },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "classes", "annotator"],
        "additionalProperties": false,
        "properties": {
          "t": { "type": "integer", "minimum": 0 },
          "classes": {
            "type": "array",
            "items": {
              "enum": [
                "none",
                "gunshot",
                "explosion",
                "siren",
                "crash",
                "scream",
                "laughter",
                "score_change",
                "kill",
                "multikill",
                "clutch",
                "replay",
                "elimination",
                "victory",
                "confrontation",
                "comedy",
                "narrative_payoff",
                "reaction",
                "ordinary"
              ]
            },
            "minItems": 1
          },
          "pov": { "enum": ["self", "teammate", "enemy", "spectator", "unknown"] },
          "annotator": { "type": "string", "minLength": 1 },
          "uncertain": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
